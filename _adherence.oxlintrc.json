      {
        "selector": "JSXOpeningElement[name.name='TimeSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|selected|disabled|note|onClick|key|ref|className|style|children)$/]",
        "message": "<TimeSlot> doesn't accept that prop. Declared props: time, selected, disabled, note, onClick."
